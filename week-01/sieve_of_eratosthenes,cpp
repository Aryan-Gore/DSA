#include <bits/stdc++.h>
using namespace std ;

 void SOE(int n){
   vector<bool> isprime(n+1, true);

   isprime[0] = isprime[1] = false;

   for(int i = 2; i*i<=n ;i++){

    if (isprime[i]){
        for(int j = i*i;j<=n; j+=i){
             isprime[j] = false;
        }
    }
   }

    for(int i = 2; i <= n; i++) {
        if(isprime[i])
            cout << i << " ";
    }


 }

int main (){
   int n ;

   cout<<" Enter a no. : ";
   cin>>n;
    
   SOE(n);
    return 0;
}
